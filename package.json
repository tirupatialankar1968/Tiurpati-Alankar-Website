{
  "name": "ta-jewelry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "rimraf dist",
    "build": "vite build",
    "check-types": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy-unix": "npm run build && cp public/_redirects dist/_redirects && cp public/_headers dist/_headers",
    "deploy-win": "npm run build && copy public\\_redirects dist\\_redirects && copy public\\_headers dist\\_headers",
    "deploy": "npm run build && node scripts/copy-netlify-files.js"
  },
  "dependencies": {
    "@types/styled-components": "^5.1.34",
    "framer-motion": "^12.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.20.0",
    "styled-components": "^6.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "rimraf": "^5.0.5",
    "terser": "^5.24.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  }
}
